    "eval:runner": "node --experimental-strip-types evals/run-runner.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "decimal.js": "10.6.0",
    "lossless-json": "4.3.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
