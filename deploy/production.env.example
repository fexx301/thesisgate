# Copy to deploy/production.env ON THE SERVER (it is git-ignored) and fill the blanks.
# deploy/bootstrap-server.sh generates the random secrets for you.

# Public HTTPS address Caddy serves, and the exact browser origin the API accepts.
SITE_ADDRESS=thesisgate.example.com
THESIS_PUBLIC_ORIGINS=https://thesisgate.example.com

# Server-only secrets (random, 32+ bytes each).
THESIS_RECOMPUTE_SIGNING_SECRET=
THESIS_VISITOR_HASH_SECRET=
THESIS_LLM_QUOTA_TOKEN=

# Model. Use a DEDICATED OpenRouter key with its own credit limit, not your local key.
THESIS_LLM_ENABLED=true
THESIS_LLM_API_KEY=
THESIS_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
THESIS_LLM_MODEL=openai/gpt-6-luna
THESIS_LLM_PROTOCOL=openai_chat
THESIS_LLM_REASONING_EFFORT=low

# Durable budget (must match the quota service, which reads these same values).
# A call reserves MAX_CALL_COST until the provider reports the real cost (~$0.001), then releases the rest.
THESIS_LLM_MAX_CALL_COST_USD=0.02
THESIS_LLM_DAILY_BUDGET_USD=3
THESIS_LLM_PER_VISITOR_BUDGET_USD=0.30
THESIS_LLM_PROVIDER_HARD_LIMIT_USD=3
THESIS_LLM_MAX_CONCURRENT=3

# SEC EDGAR requires a declared contact in the User-Agent. Sent only to sec.gov.
THESIS_SEC_USER_AGENT=ThesisGate Fexx301@proton.me

NEXT_PUBLIC_TELEMETRY_ENABLED=false
THESIS_TELEMETRY_ENABLED=false
