# Production replay-demo essentials (also required with no model key).
# Exact HTTPS origins, comma-separated; no paths, trailing slashes, or wildcards.
# Example only: https://demo.example,https://preview.example
THESIS_PUBLIC_ORIGINS=
# Generate a unique server-only secret, e.g. openssl rand -hex 32.
# Keep the same value across instances; rotation invalidates existing receipts.
THESIS_RECOMPUTE_SIGNING_SECRET=
# Keep false for the public replay demo. This disables model calls, not live market data.
THESIS_LLM_ENABLED=false

# Optional local claim model only. Never prefix these values with NEXT_PUBLIC_.
THESIS_LLM_API_KEY=
THESIS_LLM_BASE_URL=
THESIS_LLM_MODEL=
THESIS_LLM_PROTOCOL=
THESIS_LLM_REASONING_EFFORT=
THESIS_LLM_LOCAL_MAX_CONCURRENT=2

# Production model-only prerequisites. Leave unset for the replay demo.
# External durable reservations and provider hard caps remain UNVERIFIED.
# Variables alone do not implement or prove a durable quota service or hard cap.
THESIS_LLM_QUOTA_URL=
THESIS_LLM_QUOTA_TOKEN=
THESIS_LLM_MAX_CALL_COST_USD=
THESIS_LLM_DAILY_BUDGET_USD=
THESIS_LLM_PER_VISITOR_BUDGET_USD=
THESIS_LLM_MAX_CONCURRENT=
THESIS_LLM_PROVIDER_HARD_LIMIT_USD=
THESIS_VISITOR_HASH_SECRET=

# Optional sanitized tester-journey metrics; disabled for the replay demo.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
THESIS_TELEMETRY_ENABLED=false
THESIS_TELEMETRY_ENDPOINT=
THESIS_TELEMETRY_TOKEN=
